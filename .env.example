# Copy to `.env` and adjust. `.env` is git-ignored: never commit real values.
#
# Local `docker compose up` works WITHOUT a .env file (sensible defaults, no secrets).
# In production (/opt/contact-qr/.env on the server) every value marked REQUIRED must be set.

# --- Database ---------------------------------------------------------------------------
POSTGRES_USER=contactqr
POSTGRES_DB=contactqr
# REQUIRED in production. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Only for running the app outside Docker (e.g. `uv run uvicorn ...`); compose sets "db".
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Application ------------------------------------------------------------------------
LOG_LEVEL=INFO
# Region used for phone numbers written without a +country prefix (ISO 3166 alpha-2).
DEFAULT_PHONE_REGION=LT
# Delete request logs older than N days (0 = keep forever).
LOG_RETENTION_DAYS=90
# Max create/update/delete requests per client IP per minute (0 = unlimited).
RATE_LIMIT_WRITES_PER_MINUTE=30
